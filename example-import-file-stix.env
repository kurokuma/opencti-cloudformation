# Connector-specific variables only. OPENCTI_URL, OPENCTI_TOKEN,
# CONNECTOR_ID, CONNECTOR_TYPE, CONNECTOR_NAME, CONNECTOR_SCOPE and
# CONNECTOR_LOG_LEVEL are supplied by CloudFormation.

# true  : imported bundles are placed in an Analyst Workbench as a draft.
#         Nothing enters the knowledge base until an analyst validates the
#         workbench in Data -> Data import -> Analyst workbenches.
# false : bundles are ingested directly into the knowledge base.
# Set this to false if you expect uploaded STIX files to appear immediately.
CONNECTOR_VALIDATE_BEFORE_IMPORT=true

# Automatically trigger this connector when a matching file is uploaded.
CONNECTOR_AUTO=true
